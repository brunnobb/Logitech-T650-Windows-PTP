<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>T650Bridge</RootNamespace>
    <ApplicationIcon>T650.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <Flavor Condition="'$(Flavor)' == ''">Ptp</Flavor>
  </PropertyGroup>

  <!-- PTP Driver Mode: Runs as Invoker -->
  <PropertyGroup Condition="'$(Flavor)' == 'Ptp'">
    <DefineConstants>$(DefineConstants);FLAVOR_PTP</DefineConstants>
    <ApplicationManifest>app.ptp.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Admin / Solution 1 Mode: Runs elevated with requireAdministrator to bypass UIPI -->
  <PropertyGroup Condition="'$(Flavor)' == 'Admin'">
    <DefineConstants>$(DefineConstants);FLAVOR_ADMIN</DefineConstants>
    <ApplicationManifest>app.admin.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

</Project>




